# AlMomiaa Sales Rep PWA (Vite + Workbox) — Vercel Environment Variables Template
# Set these inside Vercel Project Settings -> Environment Variables (never commit real keys).

# Live Render.com backend HTTPS URL (used by api/[...path].ts same-origin cookie proxy)
BACKEND_API_ORIGIN=https://<YOUR-RENDER-SERVICE>.onrender.com

# Direct SignalR Hub URL over HTTPS/WSS (authenticated via in-memory Bearer JWT)
VITE_SIGNALR_HUB_URL=https://<YOUR-RENDER-SERVICE>.onrender.com/hubs/operations
