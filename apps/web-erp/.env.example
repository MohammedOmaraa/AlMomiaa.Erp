# AlMomiaa Web ERP (Next.js 15) — Vercel Environment Variables Template
# Set these inside Vercel Project Settings -> Environment Variables (never commit real keys).

# Live Render.com backend HTTPS URL (used by next.config.ts same-origin /api/v1 & /health proxy)
BACKEND_API_ORIGIN=https://<YOUR-RENDER-SERVICE>.onrender.com

# Direct SignalR Hub URL over HTTPS/WSS (authenticated via in-memory Bearer JWT)
NEXT_PUBLIC_SIGNALR_HUB_URL=https://<YOUR-RENDER-SERVICE>.onrender.com/hubs/operations

# Optional: Google Maps JavaScript API Key for interactive Satellite/Hybrid view on /gps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
