# Backend origin proxied by Next.js server rewrites for /api/v1 and /health
BACKEND_API_ORIGIN=http://localhost:5000

# Optional direct browser API / SignalR overrides
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_SIGNALR_HUB_URL=http://localhost:5000/hubs/operations

# Optional Google Maps JavaScript API key for interactive multi-pin Live GPS tracking (/gps)
# Leave blank to automatically use the zero-key Google Maps embed fallback
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
