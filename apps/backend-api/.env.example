# AlMomiaa ERP .NET 9 WebApi — Render.com / Cloud Docker Environment Variables Template
# NEVER commit real passwords, connection strings, or signing keys to Git.

ASPNETCORE_ENVIRONMENT=Production
Hosting__TrustForwardedHeaders=true
Swagger__Enabled=true

# Free External SQL Server (MonsterASP.NET / Somee / Azure SQL Free Offer)
ConnectionStrings__SqlServer=Server=<YOUR_SQL_HOST>;Database=<YOUR_DB_NAME>;User Id=<YOUR_SQL_USER>;Password=<YOUR_SQL_PASSWORD>;Encrypt=True;TrustServerCertificate=True;

# JWT Authentication (SigningKey MUST be >= 32 UTF-8 bytes)
Auth__Jwt__Issuer=https://<YOUR-RENDER-SERVICE>.onrender.com
Auth__Jwt__Audience=almomiaa-erp-clients
Auth__Jwt__SigningKey=<GENERATE_A_RANDOM_48_PLUS_CHAR_SECRET_KEY>

# Comma-separated exact HTTPS origins of your deployed Web ERP and Rep PWA (NO wildcard *)
Cors__AllowedOriginsCsv=https://<YOUR-WEB-ERP>.vercel.app,https://<YOUR-REP-PWA>.vercel.app

# Single-instance free demo mode (set false and provide Redis__ConnectionString for multi-node production)
Redis__AllowInMemoryFallback=true
Redis__ConnectionString=

# Opt-in automatic EF Core migrations & idempotent demo data seeding on startup
Database__AutoMigrateOnStartup=true
Demo__SeedEnabled=true
Demo__DefaultPassword=<CHOOSE_STRONG_DEMO_PASSWORD_MIN_8_CHARS>
