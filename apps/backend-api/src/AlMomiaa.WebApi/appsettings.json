{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Demo": {
    "SeedEnabled": false,
    "DefaultPassword": ""
  },
